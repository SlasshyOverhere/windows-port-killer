#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

#define PK_STR2(x) #x
#define PK_STR(x) PK_STR2(x)
#define PK_VERSION_STR PK_STR(PK_VER_MAJOR) "." PK_STR(PK_VER_MINOR) "." PK_STR(PK_VER_PATCH)

1 VERSIONINFO
FILEVERSION PK_VER_MAJOR, PK_VER_MINOR, PK_VER_PATCH, 0
PRODUCTVERSION PK_VER_MAJOR, PK_VER_MINOR, PK_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SlasshyOverhere"
            VALUE "FileDescription", "Port Killer - TCP/UDP port inspector and process killer"
            VALUE "FileVersion", PK_VERSION_STR
            VALUE "InternalName", "PortKiller"
            VALUE "OriginalFilename", "PortKiller.exe"
            VALUE "ProductName", "Port Killer"
            VALUE "ProductVersion", PK_VERSION_STR
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
